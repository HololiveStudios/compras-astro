{
  "compilerOptions": {
    /* OUTPUT */
    "noEmit": true,

    /* LANGUAGE */
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",

    /* TYPE CHECKING */
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src", "astro.config.mjs"]
}
